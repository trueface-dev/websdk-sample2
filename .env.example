# Secret key for server-to-server session creation (never exposed to the browser).
# Without it the sample runs in Manual mode only.
TRUEFACE_SECRET_KEY=

# Point these at a local API stack when testing backend changes.
TRUEFACE_API_URL=https://api.trueface.dev
TRUEFACE_GRPC_URL=https://realtime.trueface.dev

# Which published SDK build to load from jsDelivr.
TRUEFACE_SDK_VERSION=v0.2.0

PORT=4002
